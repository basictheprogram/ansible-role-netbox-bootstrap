# .env.example — copy to .env and fill in your values.
# .env is gitignored; never commit real tokens.

# ---------------------------------------------------------------------------
# export_netbox.py
# ---------------------------------------------------------------------------

# Required
NETBOX_URL=https://netbox.corp.example.com
NETBOX_TOKEN=nbt_xxxx.<your-token-here>

# Optional — these match the CLI defaults if omitted
NETBOX_OUTPUT_DIR=../vars
NETBOX_SECTIONS=
NETBOX_INSECURE=false

# ---------------------------------------------------------------------------
# export_aws_ec2.py
# ---------------------------------------------------------------------------

# Required
AWS_EXPORT_REGION=us-east-1

# Optional — these match the CLI defaults if omitted
# AWS_EXPORT_PROFILE=             # named profile from ~/.aws/config; omit for default chain
AWS_EXPORT_OUTPUT_DIR=../vars
AWS_EXPORT_FAMILIES=t,m           # comma-separated family prefixes; extend with c, r, etc.
AWS_EXPORT_CURRENT_GEN_ONLY=false

# ---------------------------------------------------------------------------
# export_aws_rds.py
# ---------------------------------------------------------------------------

# Required
# AWS_EXPORT_REGION and AWS_EXPORT_PROFILE are shared with export_aws_ec2.py

# Optional — these match the CLI defaults if omitted
# AWS_EXPORT_RDS_ENGINES=          # comma-separated engine names; omit for all
#                                  # e.g. postgres,mysql,aurora-postgresql
# AWS_EXPORT_RDS_STATUS=           # e.g. available; omit to export all statuses
